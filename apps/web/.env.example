# ============================================
# NEXT.JS FRONTEND CONFIGURATION
# ============================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
SHOPPING_SERVICE_URL=http://localhost:3004

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production-12345
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# ============================================
# ADMIN AUTHENTICATION
# ============================================
# Change this in production — do NOT commit real passwords to source control
NEXT_PUBLIC_ADMIN_PASSWORD=Admin@DC2024!

# ============================================
# GOOGLE OAUTH
# ============================================
# Get these from: https://console.cloud.google.com/
# Steps:
# 1. Create a new GCP project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add http://localhost:3000/api/auth/callback/google to authorized redirect URIs
# 5. Copy Client ID and Client Secret below

GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ============================================
# MICROSOFT OAUTH
# ============================================
# Get these from: https://portal.azure.com/
# Steps:
# 1. Go to Azure Active Directory > App Registrations
# 2. Create a new app registration
# 3. Add http://localhost:3000/api/auth/callback/microsoft-entra-id as redirect URI
# 4. Create a client secret
# 5. Copy values below

MICROSOFT_CLIENT_ID=your-microsoft-client-id-here
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-here
MICROSOFT_TENANT_ID=common

# ============================================
# BACKEND NESTJS API (apps/api)
# ============================================

# Database
DATABASE_URL=postgresql://admin:password@localhost:5432/delegatecart?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=delegatecart

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Message Broker
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=delegatecart-api

# ============================================
# SECURITY & JWT
# ============================================

API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=your-api-secret-key-change-this-in-production-12345
JWT_EXPIRATION=24h

# ============================================
# FEATURES
# ============================================

FEATURE_AI_RECOMMENDATIONS=true
FEATURE_CHECKOUT_V2=false
FEATURE_LOYALTY_PROGRAM=true
FEATURE_AI_CHAT=true
FEATURE_OAUTH=true

# ============================================
# LOGGING & MONITORING (Optional)
# ============================================

LOG_LEVEL=debug
NODE_ENV=development

# Sentry (Error tracking) - Optional
SENTRY_DSN=

# Datadog (Monitoring) - Optional
DATADOG_API_KEY=

# ============================================
# PRODUCTION ONLY
# ============================================

# These are typically secrets managed by your deployment platform:
# PROD_DATABASE_URL=
# PROD_REDIS_URL=
# PROD_JWT_SECRET=
# PROD_NEXTAUTH_SECRET=
# PROD_GOOGLE_CLIENT_ID=
# PROD_GOOGLE_CLIENT_SECRET=
# etc.
