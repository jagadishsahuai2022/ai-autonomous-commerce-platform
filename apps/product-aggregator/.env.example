# Product Aggregator Service Configuration

# API Server
API_HOST=0.0.0.0
API_PORT=3003
LOG_LEVEL=INFO

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_TTL=3600
CACHE_ENABLED=true

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP=product-aggregator-service
KAFKA_TOPIC_INTENT_PROCESSED=intent.processed
KAFKA_TOPIC_PRODUCTS_FETCHED=products.fetched
KAFKA_FETCH_TIMEOUT_MS=5000

# Internal Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=delegatecart
DB_POOL_SIZE=10

# External APIs (Mock Endpoints)
AMAZON_API_URL=http://localhost:3004/api/products
FLIPKART_API_URL=http://localhost:3005/api/products
AMAZON_API_TIMEOUT=5
FLIPKART_API_TIMEOUT=5

# Search Options
MAX_RESULTS_PER_SOURCE=10
AGGREGATOR_TIMEOUT=10
MIN_CONFIDENCE_THRESHOLD=0.0
SORT_BY_RELEVANCE=true

# Service
SERVICE_NAME=product-aggregator
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
