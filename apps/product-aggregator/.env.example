# Product Aggregator Service Configuration

# API Server
API_HOST=0.0.0.0
API_PORT=3003
LOG_LEVEL=INFO

# Redis Cache
REDIS_URL=
REDIS_TTL=3600
CACHE_ENABLED=true

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_GROUP=
KAFKA_TOPIC_INTENT_PROCESSED=
KAFKA_TOPIC_PRODUCTS_FETCHED=
KAFKA_FETCH_TIMEOUT_MS=

# Internal Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=delegatecart
DB_POOL_SIZE=10

# External APIs (Mock Endpoints)
AMAZON_API_URL=
FLIPKART_API_URL=
AMAZON_API_TIMEOUT=5
FLIPKART_API_TIMEOUT=5

# Search Options
MAX_RESULTS_PER_SOURCE=10
AGGREGATOR_TIMEOUT=10
MIN_CONFIDENCE_THRESHOLD=0.0
SORT_BY_RELEVANCE=true

# Service
SERVICE_NAME=
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
