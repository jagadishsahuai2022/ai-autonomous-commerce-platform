# Product Ranking Engine Configuration

# API Server
API_HOST=
API_PORT=
LOG_LEVEL=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_GROUP=
KAFKA_TOPIC_PRODUCTS_FETCHED=
KAFKA_TOPIC_PRODUCTS_RANKED=
KAFKA_FETCH_TIMEOUT_MS=

# Ranking Weights Configuration
WEIGHT_BUDGET_FIT=0.25
WEIGHT_QUALITY_SCORE=0.25
WEIGHT_BRAND_PREFERENCE=0.20
WEIGHT_DELIVERY_SPEED=0.15
WEIGHT_RATINGS=0.15

# Ranking Algorithm
MIN_CONFIDENCE_THRESHOLD=0.0
SCORE_PRECISION=2
USE_AI_EXPLANATION=true

# Service
SERVICE_NAME=product-ranking-engine
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
