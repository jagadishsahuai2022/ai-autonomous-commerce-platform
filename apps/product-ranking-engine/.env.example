# Product Ranking Engine Configuration

# API Server
API_HOST=0.0.0.0
API_PORT=3004
LOG_LEVEL=INFO

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP=product-ranking-engine-service
KAFKA_TOPIC_PRODUCTS_FETCHED=products.fetched
KAFKA_TOPIC_PRODUCTS_RANKED=products.ranked
KAFKA_FETCH_TIMEOUT_MS=5000

# Ranking Weights Configuration
WEIGHT_BUDGET_FIT=0.25
WEIGHT_QUALITY_SCORE=0.25
WEIGHT_BRAND_PREFERENCE=0.20
WEIGHT_DELIVERY_SPEED=0.15
WEIGHT_RATINGS=0.15

# Ranking Algorithm
MIN_CONFIDENCE_THRESHOLD=0.0
SCORE_PRECISION=2
USE_AI_EXPLANATION=true

# Service
SERVICE_NAME=product-ranking-engine
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
