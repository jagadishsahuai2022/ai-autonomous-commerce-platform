## Autopilot Engine Configuration

# Application
NODE_ENV=development
PORT=3002
LOG_LEVEL=debug

# Kafka Configuration
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_CLIENT_ID=autopilot-engine
KAFKA_GROUP_ID=autopilot-engine-group

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delegate_cart

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# API Configuration
API_PORT=3002
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Service Discovery
API_SERVICE_URL=http://localhost:3001/api/v1
RANKING_SERVICE_URL=http://localhost:8000/api/v1
INTENT_PARSER_URL=http://localhost:8001/api/v1
PRODUCT_AGGREGATOR_URL=http://localhost:8002/api/v1

# Autopilot Configuration
MIN_CONFIDENCE_THRESHOLD=0.65
AUTO_PURCHASE_ENABLED=true
APPROVAL_REQUIRED_CONFIDENCE_THRESHOLD=0.8
ANOMALY_DETECTION_ENABLED=true

# Safety Limits
MAX_MONTHLY_SPEND=500000
MAX_ORDER_VALUE=100000
MAX_ORDERS_PER_DAY=5
MIN_PRODUCT_RATING=3.0

# Feature Flags
FEATURE_AUTO_BUY=true
FEATURE_APPROVAL_WORKFLOW=true
FEATURE_ANOMALY_DETECTION=true
FEATURE_INDIA_LOCALIZATION=true
FEATURE_EMI_OPTIONS=true

# India-Specific Settings
DEFAULT_CURRENCY=INR
PREFERRED_PAYMENT_METHODS=upi,card,netbanking,wallet,emi
SUPPORT_COD=true
SUPPORT_EMI=true
DEFAULT_DELIVERY_DAYS=3
PIN_CODE_SERVICE_URL=http://localhost:3001/api/v1/pincodes
