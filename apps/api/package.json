{
  "name": "api",
  "version": "1.0.0",
  "description": "NestJS backend for AI e-commerce platform",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "seed": "node -r ts-node/register prisma/seed.ts",
    "seed:prisma": "prisma db seed",
    "test": "jest",
    "test:ci": "jest --coverage --coverageReporters=text --coverageReporters=lcov --forceExit",
    "test:unit": "jest --testPathPattern='\\.spec\\.ts$'",
    "test:integration": "jest --testPathPattern='\\.int\\.spec\\.ts$'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.ts' --collectCoverageFrom='!src/**/*.module.ts'",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^9.1.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.19",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/microservices": "11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/websockets": "11.1.19",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.10.9",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "fastify": "^5.8.5",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.3",
    "prisma": "^7.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "prisma": {
    "seed": "node -r ts-node/register prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.7",
    "@nestjs/platform-socket.io": "11.1.19",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.1.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}