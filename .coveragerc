[run]
branch = True
source = .
omit =
    */venv/*
    */.venv/*
    */tests/*
    */test_*.py
    conftest.py
    setup.py

[report]
precision = 2
show_missing = True
skip_empty = True
skip_covered = False

exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    except ImportError:
    if sys.version_info
    if six.PY
    if TYPE_CHECKING:

[html]
directory = coverage/htmlcov

[json]
output = coverage.json
pretty_print = True
show_contexts = True
