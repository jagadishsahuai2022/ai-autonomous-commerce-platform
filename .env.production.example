# ==================== Environment Configuration ====================
# DelegateCart Production Environment Setup
# Copy this to .env.production and customize for your environment

# ==================== APPLICATION ====================
NODE_ENV=production
LOG_LEVEL=INFO
PORT=3000
API_PREFIX=/api/v1

# ==================== DATABASE ====================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=
DB_POOL_SIZE=
DB_MAX_CONNECTIONS=

# Read replica configuration (for scaling)
DB_READ_REPLICAS=replica1.delegatecart.svc.cluster.local:5432,replica2.delegatecart.svc.cluster.local:5432

# ==================== REDIS ====================
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_PASSWORD=
REDIS_TTL=
REDIS_KEY_PREFIX=

# Redis Cluster (for large-scale deployments)
REDIS_CLUSTER_ENABLED=
REDIS_CLUSTER_NODES=

# ==================== JWT & SECURITY ====================
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=
JWT_REFRESH_TOKEN_EXPIRY=
JWT_ALGORITHM=

# ==================== KAFKA ====================
KAFKA_BROKERS=
KAFKA_CLIENT_ID=
KAFKA_GROUP_ID=
KAFKA_SSL=true
KAFKA_SASL_ENABLED=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ==================== AI SERVICES ====================
INTENT_PARSER_URL=
PRODUCT_AGGREGATOR_URL=
RANKING_ENGINE_URL=
AI_SERVICE_TIMEOUT=
AI_SERVICE_RETRIES=
AI_SERVICE_CIRCUIT_BREAKER_THRESHOLD=

# ==================== RATE LIMITING ====================
RATE_LIMITING_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_STRICT_MODE=true

# Custom rate limits per endpoint
RATE_LIMIT_PURCHASE_REQUESTS=10
RATE_LIMIT_PURCHASE_WINDOW_MS=60000

RATE_LIMIT_CHAT_REQUESTS=20
RATE_LIMIT_CHAT_WINDOW_MS=60000

# ==================== CACHING ====================
CACHING_ENABLED=true
CACHE_TTL=3600
CACHE_PRODUCTS=true
CACHE_SEARCH=true
CACHE_RANKINGS=true
CACHE_USER_PREFS=true

# Cache invalidation (for multi-instance deployments)
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_CHANNEL=dc:cache:invalidate

# ==================== FEATURES ====================
DEMO_MODE_ENABLED=true
AI_RANKING_ENABLED=true
AI_PRICING_ENABLED=true
WALLET_AUTO_APPROVAL=false
SELLER_AI_ENABLED=true
AUTO_PURCHASE_ENABLED=false

# ==================== OBSERVABILITY ====================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_ENDPOINT=/metrics

TRACING_ENABLED=true
TRACING_JAEGER_HOST=
TRACING_JAEGER_PORT=
TRACING_SAMPLE_RATE=

LOGGING_FORMAT=json
LOGGING_CORRELATION_ID=true

# ==================== SECURITY ====================
CORS_ORIGINS=https://delegatecart.com,https://api.delegatecart.com
ALLOWED_HOSTS=delegatecart.com,api.delegatecart.com
REQUIRE_HTTPS=true
CSRF_PROTECTION=true

# SSL/TLS Configuration
SSL_CERT_PATH=
SSL_KEY_PATH=

# ==================== MONITORING & ALERTING ====================
SENTRY_DSN=https://your-sentry-key@sentry.example.com/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# # Datadog (if using Datadog APM)
# DD_API_KEY=
# DD_APM_ENABLED=
# DD_ENV=production
# DD_SERVICE=
# DD_TRACE_SAMPLE_RATE=

# ==================== EXTERNAL SERVICES ====================
# Payment Gateway
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=your-payment-api-key
PAYMENT_GATEWAY_SECRET=your-payment-secret

# SMS/Email Services
SMS_PROVIDER_URL=https://api.sms-provider.com
SMS_API_KEY=your-sms-api-key

EMAIL_PROVIDER_URL=https://api.email-provider.com
EMAIL_API_KEY=your-email-api-key

# Fraud Detection Service
FRAUD_DETECTION_URL=https://api.fraud-detection.com
FRAUD_DETECTION_API_KEY=your-fraud-detection-key
FRAUD_DETECTION_THRESHOLD=0.7

# ==================== SCALING & LOAD BALANCING ====================
# INSTANCE_ID=${HOSTNAME}
# LOAD_BALANCER_HEALTHCHECK_URL=/health
# LOAD_BALANCER_READINESS_URL=/health/ready

# Sticky sessions for WebSocket connections
STICKY_SESSIONS=true
SESSION_AFFINITY=clientip

# ==================== BACKUP & DISASTER RECOVERY ====================
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * * # 2 AM daily
# BACKUP_RETENTION_DAYS=30

# REPLICATION_ENABLED=true
# REPLICATION_LAG_THRESHOLD=5000 # milliseconds

# ==================== FEATURE FLAGS ====================
FEATURE_FLAGS_SOURCE=redis # or database
FEATURE_FLAGS_REFRESH_INTERVAL=60000 # 1 minute

# ==================== API VERSIONING ====================
API_VERSION=v1
API_DEPRECATION_ENABLED=true
API_VERSION_RETIRE_DATE=2026-12-31

# ==================== CUSTOM SETTINGS ====================
# India-specific settings
TIMEZONE=Asia/Kolkata
CURRENCY=INR
DEFAULT_LANGUAGE=hi

# Business logic
AI_EXECUTION_MAX_AMOUNT=50000
AI_EXECUTION_MAX_DAILY=100000
AI_EXECUTION_APPROVAL_THRESHOLD=25000

WALLET_MAX_BALANCE=1000000
WALLET_FRAUD_DETECTION_ENABLED=true

SELLER_TIER_STANDARD_BENEFITS=basic
SELLER_TIER_PREMIUM_BENEFITS=enhanced
SELLER_TIER_ENTERPRISE_BENEFITS=full
