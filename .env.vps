# ═══════════════════════════════════════════════════════════════════════════════
# DelegateCart — VPS Environment File
# ═══════════════════════════════════════════════════════════════════════════════
#
# LOCATION ON VPS:  /root/delegatecart/.env
#
# Docker Compose reads this file automatically and substitutes all
# ${VAR:-default} placeholders in docker-compose.latest.yml and
# docker-compose.prod.yml.
#
# HOW TO USE:
#   1. SSH into VPS:     ssh root@<SERVER_IP>
#   2. Go to repo root:  cd /root/delegatecart
#   3. Copy this file:   cp .env.vps .env
#   4. Edit secrets:     nano .env     (update the CHANGE_ME values)
#   5. Start stack:      docker compose -f docker-compose.latest.yml \
#                          -f docker-compose.prod.yml up -d --build
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── DOMAIN ────────────────────────────────────────────────────────────────────
# Your Hostinger domain (without https://)
# Used by docker-compose.prod.yml to set NEXTAUTH_URL and NEXT_PUBLIC_API_URL
DOMAIN=delegatecart.com

# ── DATABASE (VPS-local Postgres container) ───────────────────────────────────
# These are used inside docker-compose to build the DATABASE_URL.
# The Postgres container is NOT exposed to the internet — internal Docker only.
DB_NAME=delegatecart
DB_USER=admin
DB_PASSWORD=DelegatecartDB@May2026

# ── SECURITY ──────────────────────────────────────────────────────────────────
# Change these to long random strings in production.
# Generate one: openssl rand -hex 32
JWT_SECRET=JWTTokenGDKJEWE15fggvDWSAD442367DCBKJBdfdDelegateCart
NEXTAUTH_SECRET=NextAuthSecretGDKJEWE15fggvDWSAD442367DCBKJBdfdDelegateCart

# ── LLM / AI KEYS ─────────────────────────────────────────────────────────────
# At least one is required for the AI intent-parser to work.
# Leave blank if not using that provider.
# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-3-opus-20240229
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4-turbo-preview


# ── PAYMENTS ──────────────────────────────────────────────────────────────────
# Razorpay (test keys are fine for testing)
RAZORPAY_KEY_ID=rzp_test_SZMvk0O3vCYwWM
RAZORPAY_KEY_SECRET=BMlybh5tfzR0bpGTz2n4qiU6
# Set to true to enable mock payment flow (no real Razorpay needed)
ENABLE_MOCK_PAYMENT=true

# ── OAUTH (optional — only needed if Google/Microsoft login is enabled) ───────
GOOGLE_CLIENT_ID=
